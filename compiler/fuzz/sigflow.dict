# libFuzzer dictionary: SigFlow keywords, operators, and argument names, so mutations build
# well-formed statements instead of random bytes.
kw_capture="capture"
kw_fir="fir"
kw_fft="fft"
kw_magnitude="magnitude"
kw_xcorr="xcorr"
kw_emit="emit"
op_pipe="|>"
op_arrow="->"
op_assign="="
arg_rate="rate="
arg_taps="taps="
arg_n="n="
paren_open="("
paren_close=")"
comma=","
quote="\""
comment="#"
newline="\x0a"
number="2.4e6"
