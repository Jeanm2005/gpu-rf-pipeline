0: %0 = capture "fixtures/ch0.cf32" : stream<cf32> @1e6   # a
1: %1 = capture "fixtures/ch1.cf32" : stream<cf32> @1e6   # b
2: %2 = fir %0 taps="fixtures/lowpass.f32" : stream<cf32> @1e6 [fused 0]   # la
3: %3 = fir %1 taps="fixtures/lowpass.f32" : stream<cf32> @1e6 [fused 0]   # lb
4: %4 = fft %2 n=1024 : frames<cf32, 1024> @1e6
5: %5 = magnitude %4 : frames<f32, 1024> @1e6   # spec
6: %6 = xcorr %2 %3 : stream<cf32> @1e6   # corr
7: %7 = fir %0 taps="fixtures/lowpass_long.f32" : stream<cf32> @1e6   # lo
8: emit %5 -> "out/spectrum.f32"
9: emit %6 -> "out/xcorr.cf32"
10: emit %7 -> "out/lo.cf32"
