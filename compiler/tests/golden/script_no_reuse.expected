#!/usr/bin/env bash
# Generated by sigflowc from script_no_reuse.sf. Do not edit.
# One rfgpu command per scheduled IR node. Relative paths resolve against the
# directory this script is run from. Set RFGPU to use a binary that is not on PATH.
set -euo pipefail
RFGPU="${RFGPU:-rfgpu}"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# %2 = fir %0 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6   # la
"$RFGPU" fir --in 'fixtures/ch0.cf32' --taps 'fixtures/lowpass.f32' --out "$WORK/b2"

# %3 = fir %1 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6   # lb
"$RFGPU" fir --in 'fixtures/ch1.cf32' --taps 'fixtures/lowpass.f32' --out "$WORK/b3"

# %4 = fft %2 n=1024 : frames<cf32, 1024> @2.4e6
"$RFGPU" spectrum --in "$WORK/b2" --nfft 1024 --out "$WORK/b4"

# %5 = magnitude %4 : frames<f32, 1024> @2.4e6   # spec
"$RFGPU" magnitude --in "$WORK/b4" --out "$WORK/b5"

# %6 = xcorr %2 %3 : stream<cf32> @2.4e6   # corr
"$RFGPU" xcorr --a "$WORK/b2" --b "$WORK/b3" --out "$WORK/b6"

# emit %5 -> "out/spectrum.f32"
mkdir -p 'out'
cp "$WORK/b5" 'out/spectrum.f32'

# emit %6 -> "out/xcorr.cf32"
mkdir -p 'out'
cp "$WORK/b6" 'out/xcorr.cf32'
