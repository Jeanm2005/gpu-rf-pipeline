#include <cstdio>
#include <exception>
#include <vector>

int main(int argc, char** argv)
try {
    sigflow::Runtime rt("cuda_dsp_ops.sf", "fir=naive xcorr=naive", false, true, argc, argv);

    // Captures, read once.
    const std::vector<cf32> h0 = rt.read_capture("fixtures/tone.cf32");  // %0 = capture "fixtures/tone.cf32" : stream<cf32> @1e6   # x
    const std::vector<cf32> h1 = rt.read_capture("fixtures/tone_odd.cf32");  // %1 = capture "fixtures/tone_odd.cf32" : stream<cf32> @1e6   # y

    // Samples in every value.
    const std::size_t n0 = h0.size();
    const std::size_t n1 = h1.size();
    const std::size_t n2 = sigflow::padded_to_frames(n0, 16);
    const std::size_t n3 = n2;
    const std::size_t n4 = n0 + n1 - 1;

    // Buffer slots from liveness analysis, each as large as the largest value it holds.
    rt.need(0, n0 * sizeof(cf32));  // %0
    rt.need(1, n1 * sizeof(cf32));  // %1
    rt.need(2, n2 * sizeof(cf32));  // %2
    rt.need(3, n3 * sizeof(float));  // %3
    rt.need(2, n4 * sizeof(cf32));  // %4
    rt.allocate_slots();

    // Taps and FFT plans.
    int taps2 = 0;
    const float* t2 = rt.taps("fixtures/channelizer_proto.f32", taps2);
    const cufftHandle plan2 = rt.fft_plan(16, n2 / 16);
    const XcorrFft& gcc4 = rt.xcorr_fft(n0, n1, true);

    // Host copies of the emitted values.
    std::vector<float> out5(n3);  // emit %3 -> "out/c.f32"
    std::vector<cf32> out6(n4);  // emit %4 -> "out/g.cf32"

