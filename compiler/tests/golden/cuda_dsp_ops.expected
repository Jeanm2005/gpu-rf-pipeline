        },
        [&] {
            // %2 = channelize %0 taps="fixtures/channelizer_proto.f32" channels=16 : frames<cf32, 16> @1e6
            channelize_device(plan2, rt.slot<cf32>(0), t2, rt.slot<cf32>(2), static_cast<int>(n0), 16, taps2);
            rt.count("channelize");
            rt.count("cufft");
            // %3 = magnitude %2 : frames<f32, 16> @1e6   # c
            magnitude_device(rt.slot<cf32>(2), rt.slot<float>(3), static_cast<int>(n3));
            rt.count("magnitude");
            // %4 = gcc_phat %0 %1 : stream<cf32> @1e6   # g
            gcc4.run(rt.slot<cf32>(0), rt.slot<cf32>(1), rt.slot<cf32>(2));
            rt.count("cufft");
            rt.count("cufft");
            rt.count("gcc_phat_weight");
            rt.count("cufft");
