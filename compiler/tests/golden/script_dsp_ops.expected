#!/usr/bin/env bash
# Generated by sigflowc from script_dsp_ops.sf. Do not edit.
# One rfgpu command per scheduled IR node. Relative paths resolve against the
# directory this script is run from. Set RFGPU to use a binary that is not on PATH.
set -euo pipefail
RFGPU="${RFGPU:-rfgpu}"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# %2 = channelize %0 taps="fixtures/channelizer_proto.f32" channels=16 : frames<cf32, 16> @1e6
"$RFGPU" channelize --in 'fixtures/tone.cf32' --taps 'fixtures/channelizer_proto.f32' --channels 16 --out "$WORK/b2"

# %3 = magnitude %2 : frames<f32, 16> @1e6   # c
"$RFGPU" magnitude --in "$WORK/b2" --out "$WORK/b3"

# %4 = gcc_phat %0 %1 : stream<cf32> @1e6   # g
"$RFGPU" gcc_phat --a 'fixtures/tone.cf32' --b 'fixtures/tone_odd.cf32' --out "$WORK/b2"

# emit %3 -> "out/c.f32"
mkdir -p 'out'
cp "$WORK/b3" 'out/c.f32'

# emit %4 -> "out/g.cf32"
mkdir -p 'out'
cp "$WORK/b2" 'out/g.cf32'
