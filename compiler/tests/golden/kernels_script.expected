#!/usr/bin/env bash
# Generated by sigflowc from kernels_script.sf. Do not edit.
# One rfgpu command per scheduled IR node. Relative paths resolve against the
# directory this script is run from. Set RFGPU to use a binary that is not on PATH.
set -euo pipefail
RFGPU="${RFGPU:-rfgpu}"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# %2 = fir %0 taps="fixtures/lowpass.f32" : stream<cf32> @1e6 [fused 0]   # la
"$RFGPU" fir --in 'fixtures/ch0.cf32' --taps 'fixtures/lowpass.f32' --out "$WORK/b2" --impl tiled

# %3 = fir %1 taps="fixtures/lowpass.f32" : stream<cf32> @1e6 [fused 0]   # lb
"$RFGPU" fir --in 'fixtures/ch1.cf32' --taps 'fixtures/lowpass.f32' --out "$WORK/b3" --impl tiled

# %4 = xcorr %2 %3 : stream<cf32> @1e6   # corr
"$RFGPU" xcorr --a "$WORK/b2" --b "$WORK/b3" --out "$WORK/b0" --impl tiled

# emit %4 -> "out/xcorr.cf32"
mkdir -p 'out'
cp "$WORK/b0" 'out/xcorr.cf32'
