0: %0 = capture "fixtures/ch1.cf32" : stream<cf32> @2.4e6   # b
1: %1 = fir %0 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6   # lb
2: %2 = capture "fixtures/ch0.cf32" : stream<cf32> @2.4e6   # a
3: %3 = fir %2 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6   # la
4: %4 = xcorr %1 %3 : stream<cf32> @2.4e6   # corr
5: emit %4 -> "out/xcorr.cf32"
