#include "device_ops.hpp"
#include "pipeline_runtime.hpp"

#include <cstdio>
#include <exception>
#include <vector>

int main(int argc, char** argv)
try {
    sigflow::Runtime rt("cuda_two_channel.sf", false, true, argc, argv);

    // Captures, read once.
    const std::vector<cf32> h0 = rt.read_capture("fixtures/ch0.cf32");  // %0 = capture "fixtures/ch0.cf32" : stream<cf32> @2.4e6   # a
    const std::vector<cf32> h1 = rt.read_capture("fixtures/ch1.cf32");  // %1 = capture "fixtures/ch1.cf32" : stream<cf32> @2.4e6   # b

    // Samples in every value.
    const std::size_t n0 = h0.size();
    const std::size_t n1 = h1.size();
    const std::size_t n2 = n0;
    const std::size_t n3 = n1;
    const std::size_t n4 = sigflow::padded_to_frames(n2, 1024);
    const std::size_t n5 = n4;
    const std::size_t n6 = n2 + n3 - 1;

    // Buffer slots from liveness analysis, each as large as the largest value it holds.
    rt.need(0, n0 * sizeof(cf32));  // %0
    rt.need(1, n1 * sizeof(cf32));  // %1
    rt.need(2, n2 * sizeof(cf32));  // %2
    rt.need(2, n4 * sizeof(cf32));  // %2 padded for %4
    rt.need(3, n3 * sizeof(cf32));  // %3
    rt.need(1, n4 * sizeof(cf32));  // %4
    rt.need(4, n5 * sizeof(float));  // %5
    rt.need(1, n6 * sizeof(cf32));  // %6
    rt.allocate_slots();

    // Taps and FFT plans.
    int taps2 = 0;
    const float* t2 = rt.taps("fixtures/lowpass.f32", taps2);
    int taps3 = 0;
    const float* t3 = rt.taps("fixtures/lowpass.f32", taps3);
    const cufftHandle plan4 = rt.fft_plan(1024, n4 / 1024);

    // Host copies of the emitted values.
    std::vector<float> out7(n5);  // emit %5 -> "out/spectrum.f32"
    std::vector<cf32> out8(n6);  // emit %6 -> "out/xcorr.cf32"

    rt.run(
        [&] {
            CUDA_CHECK(cudaMemcpy(rt.slot<cf32>(0), h0.data(), n0 * sizeof(cf32), cudaMemcpyHostToDevice));
            CUDA_CHECK(cudaMemcpy(rt.slot<cf32>(1), h1.data(), n1 * sizeof(cf32), cudaMemcpyHostToDevice));
        },
        [&] {
            // %2 = fir %0 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6 [fused 0]   # la
            fir_naive_device(rt.slot<cf32>(0), t2, rt.slot<cf32>(2), static_cast<int>(n2), taps2);
            rt.count("fir");
            // %3 = fir %1 taps="fixtures/lowpass.f32" : stream<cf32> @2.4e6 [fused 0]   # lb
            fir_naive_device(rt.slot<cf32>(1), t3, rt.slot<cf32>(3), static_cast<int>(n3), taps3);
            rt.count("fir");
            // %4 = fft %2 n=1024 : frames<cf32, 1024> @2.4e6
            if (n4 > n2) {  // zero the last frame's padding
                CUDA_CHECK(cudaMemsetAsync(rt.slot<cf32>(2) + n2, 0, (n4 - n2) * sizeof(cf32)));
                rt.count("memset");
            }
            spectrum_device(plan4, rt.slot<cf32>(2), rt.slot<cf32>(1));
            rt.count("cufft");
            // %5 = magnitude %4 : frames<f32, 1024> @2.4e6   # spec
            magnitude_device(rt.slot<cf32>(1), rt.slot<float>(4), static_cast<int>(n5));
            rt.count("magnitude");
            // %6 = xcorr %2 %3 : stream<cf32> @2.4e6   # corr
            xcorr_naive_device(rt.slot<cf32>(2), rt.slot<cf32>(3), rt.slot<cf32>(1), static_cast<int>(n2), static_cast<int>(n3));
            rt.count("xcorr");
        },
        [&] {
            CUDA_CHECK(cudaMemcpy(out7.data(), rt.slot<float>(4), n5 * sizeof(float), cudaMemcpyDeviceToHost));
            CUDA_CHECK(cudaMemcpy(out8.data(), rt.slot<cf32>(1), n6 * sizeof(cf32), cudaMemcpyDeviceToHost));
        });

    rt.write_f32("out/spectrum.f32", out7);
    rt.write_cf32("out/xcorr.cf32", out8);
    rt.write_cf32("out/a_copy.cf32", h0);
    rt.report();
    return 0;
} catch (const std::exception& e) {
    std::fprintf(stderr, "error: %s\n", e.what());
    return 1;
}
