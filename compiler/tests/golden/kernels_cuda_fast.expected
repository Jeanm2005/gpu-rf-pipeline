    const std::vector<cf32> h1 = rt.read_capture("fixtures/ch1.cf32");  // %1 = capture "fixtures/ch1.cf32" : stream<cf32> @1e6   # b

    // Samples in every value.
    const std::size_t n0 = h0.size();
